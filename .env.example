# Giá trị mặc định cho MÔI TRƯỜNG DEV: chạy được ngay sau `cp .env.example .env`.
# Đổi toàn bộ mật khẩu trước khi triển khai thật. KHÔNG commit file .env.
# Chỉ dùng chữ, số và dấu gạch dưới trong mật khẩu để tránh lỗi đọc biến.

POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=dev_postgres_pw
POSTGRES_DB=smartcampus

KC_DB_PASSWORD=dev_keycloak_db_pw
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev_keycloak_admin_pw

AUTHENTICATOR_PASSWORD=dev_authenticator_pw

FLOWABLE_ADMIN_USER_ID=admin
FLOWABLE_ADMIN_PASSWORD=dev_flowable_admin_pw
FLOWABLE_DB_PASSWORD=dev_flowable_db_pw

# Dán JWKS lấy từ http://localhost:8080/realms/dxos/protocol/openid-connect/certs (xem README, Bước 3)
PGRST_JWT_SECRET='{"keys":[]}'