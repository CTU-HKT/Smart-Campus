routes:
  # Route for PostgREST API
  - id: 1
    uri: "/api/postgrest/*"
    plugins:
      proxy-rewrite:
        regex_uri:
          - "^/api/postgrest/(.*)"
          - "/$1"
      openid-connect:
        client_id: "portal"
        client_secret: ""
        discovery: "http://keycloak:8080/realms/dxos/.well-known/openid-configuration"
        bearer_only: true
        use_jwks: true
        realm: "dxos"
      cors:
        allow_origins: "http://localhost:3001"
        allow_methods: "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        allow_headers: "Authorization,Content-Type,Accept,Prefer"
        allow_credential: true
    upstream:
      type: roundrobin
      nodes:
        "postgrest:3000": 1

  # Route for Flowable Workflow Engine
  - id: 2
    uri: "/api/flowable/*"
    plugins:
      proxy-rewrite:
        regex_uri:
          - "^/api/flowable/process-api/(.*)"
          - "/flowable-rest/service/$1"
          - "^/api/flowable/(.*)"
          - "/$1"
        # Flowable REST chỉ hiểu Basic auth. Gateway kiểm tra JWT (openid-connect) trước,
        # sau đó gắn thông tin đăng nhập dịch vụ lấy từ .env (render lúc khởi động, xem docker-compose.yml).
        headers:
          set:
            Authorization: "Basic __FLOWABLE_BASIC_B64__"
      openid-connect:
        client_id: "portal"
        client_secret: ""
        discovery: "http://keycloak:8080/realms/dxos/.well-known/openid-configuration"
        bearer_only: true
        use_jwks: true
        realm: "dxos"
      cors:
        allow_origins: "http://localhost:3001"
        allow_methods: "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        allow_headers: "Authorization,Content-Type,Accept,Prefer"
        allow_credential: true
    upstream:
      type: roundrobin
      nodes:
        "flowable:8081": 1
#END
